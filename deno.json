{
  "tasks": {
    "check:fmt": "deno fmt --check .",
    "check:lint": "deno lint .",
    "check": {
      "command": "deno check",
      "dependencies": ["check:fmt", "check:lint"]
    },
    "dev": "vite",
    "build": "vite build",
    "start": "deno serve -A _fresh/server.js",
    "update": "deno run -A -r jsr:@fresh/update .",
    "test": "KV_PATH=\":memory:\" deno test --allow-read=. --allow-env --allow-net",
    "update-deps": "deno cache --reload main.ts"
  },
  "lint": { "rules": { "tags": ["fresh", "recommended"] } },
  "exclude": ["**/_fresh/*"],
  "nodeModulesDir": "auto",
  "imports": {
    "@/": "./",
    "@denorg/scrypt": "jsr:@denorg/scrypt@^4.4.4",
    "@fresh/plugin-vite": "jsr:@fresh/plugin-vite@^1.0.8",
    "@preact/signals": "npm:@preact/signals@^2.8.1",
    "@std/assert": "jsr:@std/assert@^1.0.18",
    "@std/datetime": "jsr:@std/datetime@^0.225.7",
    "@std/http": "jsr:@std/http@^1.0.24",
    "@tabler/icons-preact": "npm:@tabler/icons-preact@^3.36.1",
    "@tailwindcss/vite": "npm:@tailwindcss/vite@^4.2.0",
    "fresh": "jsr:@fresh/core@^2.2.0",
    "parse5": "npm:parse5@^8.0.0",
    "preact": "npm:preact@^10.28.4",
    "tailwindcss": "npm:tailwindcss@^4.2.0",
    "vite": "npm:vite@^7.3.1"
  },
  "compilerOptions": {
    "lib": [
      "dom",
      "dom.asynciterable",
      "dom.iterable",
      "deno.ns",
      "deno.unstable"
    ],
    "jsx": "precompile",
    "jsxImportSource": "preact",
    "jsxPrecompileSkipElements": ["a", "img", "source", "body", "html", "head"],
    "types": [
      "vite/client"
    ]
  },
  "unstable": ["kv"]
}
